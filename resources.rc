      VALUE "ProductVersion", "0.1.0-beta.4"
      VALUE "FileVersion", "0.1.0-beta.4"
      VALUE "OriginalFilename", "ScrubDaddy.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
